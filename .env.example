# Browser-visible Supabase project settings.
# These values are safe to expose only when database tables enforce correct RLS policies.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never add SUPABASE_SECRET_KEY (or legacy service_role) to VITE_ variables,
# source control, or browser bundles. Keep server secrets in server-only environments.
